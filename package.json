{
  "name": "sheetflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --cache",
    "lint:fix": "eslint --fix .",
    "format": "prettier './**/*.{js,ts,jsx,tsx,mjs,cjs,json}' --write",
    "check": "tsc -b --noEmit",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clear-cache": "rm -rf ./node_modules/.cache",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mantine/hooks": "^8.3.4",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@mui/utils": "^7.3.3",
    "@xyflow/react": "^12.8.6",
    "clsx": "^2.1.1",
    "elkjs": "^0.11.0",
    "events": "^3.3.0",
    "fast-deep-equal": "^3.1.3",
    "hyperformula": "^3.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-inspector": "^9.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.12",
    "@eslint/js": "^9.37.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@storybook/addon-docs": "^9.1.10",
    "@storybook/addon-links": "^9.1.10",
    "@storybook/addon-themes": "^9.1.10",
    "@storybook/react-vite": "^9.1.10",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/eslint-plugin": "^1.3.17",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "7.0.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "eslint-plugin-storybook": "^9.1.10",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "storybook": "^9.1.10",
    "type-fest": "^5.1.0",
    "typed-emitter": "^2.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "7.1.9",
    "vitest": "^3.2.4",
    "web-worker": "^1.5.0",
    "wrangler": "^4.42.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "vite": "npm:rolldown-vite@7.1.16"
    }
  },
  "packageManager": "pnpm@10.18.2"
}
